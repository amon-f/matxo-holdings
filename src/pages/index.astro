---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { clients } from '../data/clients';
import { services } from '../data/services';
import { siteBase } from '../utils/site';
---

<Layout>
  <SiteHeader active="home" />

  <main>
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-dot"></span> CLEANING &amp; MAINTENANCE SERVICES</p>
        <h1 id="hero-title">Clean spaces.<br /><span>Safer places.</span></h1>
        <p class="hero-lede">Professional building care, planned with safety in mind.</p>
        <p class="hero-body">From window cleaning and glass maintenance to painting, repairs and work at height, Matxo helps keep buildings clean, cared for and ready for what’s next.</p>
        <div class="hero-actions">
          <a class="button button-red" href={`${siteBase}contact`}>Request a site assessment <span aria-hidden="true">↗</span></a>
          <a class="button button-outline" href="tel:+254723234846"><svg class="phone-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 10 7.7 8.2 9.5c1.1 2.4 3 4.3 5.4 5.4l1.8-1.8 4.2 2.8-.7 3.1c-.2.8-.9 1.3-1.7 1.3C9.8 19.8 4.2 14.2 3.7 6.8c-.1-.8.5-1.5 1.3-1.7l2.2-.6Z" /></svg> 0723 234 846</a>
        </div>
        <div class="hero-proof" aria-label="Our service principles">
          <span><i aria-hidden="true">✓</i> Professional</span>
          <span><i aria-hidden="true">✓</i> Reliable</span>
          <span><i aria-hidden="true">✓</i> Safety-minded</span>
        </div>
      </div>

      <div class="hero-visual">
        <img src={`${siteBase}images/matxo-window-technician.jpg`} alt="Matxo technician carrying out window work using safety equipment" fetchpriority="high" />
        <div class="image-wash" aria-hidden="true"></div>
        <div class="photo-label">
          <span class="photo-label-icon" aria-hidden="true">↗</span>
          <span><strong>Work at height</strong><small>Planned with care</small></span>
        </div>
        <div class="hero-stamp" aria-hidden="true"><span>MATXO</span><small>BUILDING<br />CARE</small></div>
      </div>
      <div class="hero-bottomline"><span>Clean spaces. Safer places. A healthier tomorrow.</span><span class="scroll-cue">SCROLL TO EXPLORE <b aria-hidden="true">↓</b></span></div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="shell services-inner">
        <div class="services-heading">
          <div>
            <p class="section-kicker"><span></span> WHAT WE DO</p>
            <h2 id="services-title">Building care,<br /><em>all in one place.</em></h2>
          </div>
          <p class="services-intro">From glass cleaning to repairs and work at height, Matxo brings essential building services together. We confirm the right scope for each site before work begins.</p>
        </div>

        <div class="service-grid">
          {services.map((service, index) => (
            <article class="service-card">
              <div class="service-card-top">
                <span class="service-number">0{index + 1} <span> / 06</span></span>
                <span class="service-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
              <a href={`${siteBase}contact?service=${service.slug}`} aria-label={`Enquire about ${service.title}`}>Ask about this service <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>

        <div class="services-note">
          <p><strong>Every building is different.</strong> Tell us what you need and we’ll help define the next step.</p>
          <a class="services-contact" href={`${siteBase}contact`}>Discuss your site <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="safety-section" id="safety" aria-labelledby="safety-title">
      <div class="shell safety-inner">
        <div class="safety-copy">
          <p class="safety-kicker"><span class="safety-shield" aria-hidden="true">✓</span> SAFETY IN EVERY STEP</p>
          <h2 id="safety-title">Good work<br />starts with a<br /><span>safe plan.</span></h2>
          <p class="safety-intro">Every building brings different access, surfaces and activity. We start by understanding the site and requested work, then agree the scope and coordination needed before scheduling.</p>
          <a class="button button-red" href={`${siteBase}contact`}>Arrange a site assessment <span aria-hidden="true">↗</span></a>
        </div>

        <div class="safety-process" aria-label="How Matxo plans building work">
          <article class="safety-step">
            <span class="safety-step-number">01</span>
            <div><h3>Understand the site</h3><p>Discuss the building, the areas involved, access needs and any site requirements.</p></div>
            <span class="safety-step-arrow" aria-hidden="true">↗</span>
          </article>
          <article class="safety-step">
            <span class="safety-step-number">02</span>
            <div><h3>Define the work</h3><p>Clarify the requested service, the work area and what needs to be agreed before starting.</p></div>
            <span class="safety-step-arrow" aria-hidden="true">↗</span>
          </article>
          <article class="safety-step">
            <span class="safety-step-number">03</span>
            <div><h3>Coordinate the next steps</h3><p>Confirm timing and practical arrangements with the client for the specific site.</p></div>
            <span class="safety-step-arrow" aria-hidden="true">↗</span>
          </article>
          <p class="safety-note"><span aria-hidden="true">+</span> Share site access details and any scheduling constraints when you get in touch.</p>
        </div>
      </div>
    </section>

    <section class="clients-section" aria-labelledby="clients-title">
      <div class="shell">
        <div class="clients-heading">
          <p class="section-kicker"><span></span> OUR CLIENTS</p>
          <h2 id="clients-title">Organizations we’re proud to work with.</h2>
        </div>
        <div class="client-grid">
          {clients.map((client) => (
            <figure class="client-card">
              <img src={`${siteBase}images/clients/${client.logo}`} alt="" loading="lazy" />
              <figcaption>{client.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="contact-cta-section" aria-labelledby="contact-cta-title">
      <div class="shell">
        <div class="contact-cta">
          <div class="contact-cta-copy">
            <p class="contact-cta-kicker"><span></span> START A CONVERSATION</p>
            <h2 id="contact-cta-title">Let’s talk about<br />your building.</h2>
            <p>Tell us the service you need, where the work is, and your preferred timing. We’ll discuss the scope and a practical next step.</p>
          </div>
          <div class="contact-cta-actions">
            <a class="button button-light" href={`${siteBase}contact`}>Request a quote <span aria-hidden="true">↗</span></a>
            <a class="contact-cta-call" href="tel:+254723234846"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 3.5 10 7.7 8.2 9.5c1.1 2.4 3 4.3 5.4 5.4l1.8-1.8 4.2 2.8-.7 3.1c-.2.8-.9 1.3-1.7 1.3C9.8 19.8 4.2 14.2 3.7 6.8c-.1-.8.5-1.5 1.3-1.7l2.2-.6Z" /></svg> Call 0723 234 846</a>
          </div>
          <span class="contact-cta-ring" aria-hidden="true"></span>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Layout>
